<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dock_content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:gravity="center_horizontal|top"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

        <!-- Clock -->
        <LinearLayout
            android:id="@+id/clock_settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextClock
                android:id="@+id/dock_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/cl_m3_light_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="0.8"
                android:format24Hour="@string/car_dock_clock_24h"
                android:format12Hour="@string/car_dock_clock_12h"/>

        </LinearLayout>


    <!-- ORTA CONTAINER (Kısayollar) -->
    <LinearLayout
        android:id="@+id/center_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Shortcuts RecyclerView + overlay wrapper -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Shortcuts RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:clipToPadding="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:orientation="vertical"
        android:layout_weight="0"/>

            <!-- Alt Gradient Overlay: Devami oldugunda gorulur -->
            <View
                android:id="@+id/dock_end_fade"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_dock_end_fade_vertical"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Mini Music Player (Dikey Dock'ta GONE) -->
        <LinearLayout
            android:id="@+id/mini_music_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_drawer_rounded"
            android:padding="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mini_music_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/cl_accent_orange"
                android:layout_marginBottom="0dp"/>

            <TextView
                android:id="@+id/mini_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Muzik"
                android:textColor="@color/cl_text_primary"
                android:textSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:layout_marginBottom="4dp"/>

            <ImageButton
                android:id="@+id/mini_btn_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_play"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="@color/cl_primary"
                android:layout_marginBottom="0dp"/>

            <ImageButton
                android:id="@+id/mini_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="@color/cl_text_secondary"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Assistant above the bottom navigation buttons -->
    <LinearLayout
        android:id="@+id/right_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Assistant Button -->
        <ImageButton
            android:id="@+id/btn_assistant"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:padding="12dp"
            android:layout_marginBottom="4dp"
            app:tint="@color/cl_text_secondary"/>


    </LinearLayout>

    <!-- Bottom navigation: layout mode and app drawer -->
    <LinearLayout
        android:id="@+id/left_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_desktop_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_desktop_mode"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:tint="@color/cl_text_hint"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/btn_app_list"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Apps"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_apps_9_dots"
            app:tint="@color/cl_primary"
            android:padding="12dp" />

    </LinearLayout>


    <!-- Hidden Layout Toggle Button -->
    <ImageButton
        android:id="@+id/btn_layout_toggle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
