<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dual_card_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@android:color/transparent">

    <!-- 1. UST KART: TELEMETRI & DIJITAL GOSTERGE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_telemetry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_rounded_dark"
        android:padding="12dp"
        android:elevation="6dp"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">

        <!-- Pusula / Yon Bilgisi -->
        <TextView
            android:id="@+id/telemetry_compass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="K"
            android:textColor="#3FD9CA"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Menu Butonu -->
        <ImageButton
            android:id="@+id/dual_panel_menu_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:tint="#88FFFFFF"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:contentDescription="Menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hiz Limiti Tabelasi (Varsayilan GONE) -->
        <FrameLayout
            android:id="@+id/telemetry_speed_limit_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_circle_button"
                app:tint="#D32F2F"/>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_circle_button"
                app:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/telemetry_speed_limit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="80"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Anlik Dijital Hiz -->
        <LinearLayout
            android:id="@+id/telemetry_speed_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/telemetry_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="54sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"/>

            <TextView
                android:id="@+id/telemetry_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>
        </LinearLayout>

        <!-- Saat Bilgisi -->
        <app.vela.carlauncher.widgets.InterlockingClockView
            android:id="@+id/telemetry_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. ALT KART: MEDYA & CANLI MUZIK CALAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_music"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:background="@drawable/bg_card_rounded_dark"
        android:padding="12dp"
        android:elevation="6dp"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">

        <!-- Bulanik Album Kapagi Arka Katmani -->
        <ImageView
            android:id="@+id/dual_music_album_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="0.25"
            android:src="@drawable/bg_default_music_art"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Mini Album Kapagi -->
        <ImageView
            android:id="@+id/dual_music_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_album_art"
            android:background="@drawable/bg_track_art_placeholder"
            android:padding="6dp"
            app:tint="#88FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Parca & Sanatci Bilgisi -->
        <LinearLayout
            android:id="@+id/dual_music_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintTop_toTopOf="@id/dual_music_art"
            app:layout_constraintBottom_toBottomOf="@id/dual_music_art"
            app:layout_constraintStart_toEndOf="@id/dual_music_art"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/dual_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parca Adi"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/dual_music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sanatci"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Canli Muzik Gorsellestirici Dalgalari -->
        <app.vela.carlauncher.widgets.MusicVisualizerView
            android:id="@+id/dual_music_visualizer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/dual_music_art"
            app:layout_constraintBottom_toTopOf="@id/dual_music_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Ilerleme Cubugu -->
        <ProgressBar
            android:id="@+id/dual_music_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginBottom="8dp"
            android:max="1000"
            android:progressTint="#3FD9CA"
            android:progressBackgroundTint="#33FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dual_music_controls"/>

        <!-- Kontroller (Onceki, Oynat/Duraklat, Sonraki) -->
        <LinearLayout
            android:id="@+id/dual_music_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/dual_music_btn_prev"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_music_prev"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/dual_music_btn_play"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/cl_primary"
                android:src="@android:drawable/ic_media_play"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/dual_music_btn_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_music_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
