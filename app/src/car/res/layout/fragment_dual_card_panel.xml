<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dual_card_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@android:color/transparent">

    <!-- 1. UST KART: TELEMETRI & DIJITAL GOSTERGE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_telemetry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dual_card"
        android:padding="14dp"
        android:elevation="6dp"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">

        <!-- Pusula / Yon Bilgisi -->
        <TextView
            android:id="@+id/telemetry_compass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="K"
            android:textColor="#3FD9CA"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Menu Butonu (3 Nokta) -->
        <ImageButton
            android:id="@+id/dual_panel_menu_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="Menu"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hiz Limiti Tabelasi (Varsayilan GONE) -->
        <FrameLayout
            android:id="@+id/telemetry_speed_limit_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/telemetry_compass"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_circle_button"
                app:tint="#D32F2F"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_circle_button"
                app:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/telemetry_speed_limit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="80"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Canli Neon Futuristic Hiz Gostergesi -->
        <app.vela.carlauncher.widgets.FuturisticSpeedometerView
            android:id="@+id/futuristic_speed"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Anlik Dijital Hiz (Fallback / Hizli referans - GONE) -->
        <LinearLayout
            android:id="@+id/telemetry_speed_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/telemetry_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"/>

            <TextView
                android:id="@+id/telemetry_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="#88FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>
        </LinearLayout>

        <!-- Saat Bilgisi -->
        <TextClock
            android:id="@+id/telemetry_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:format24Hour="HH:mm"
            android:format12Hour="h:mm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. ALT KART: MEDYA & CANLI MUZIK CALAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_music"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:background="@drawable/bg_dual_card"
        android:padding="14dp"
        android:elevation="6dp"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">

        <!-- Bulanik Album Kapagi Arka Katmani -->
        <ImageView
            android:id="@+id/dual_music_album_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="0.25"
            android:src="@drawable/bg_default_music_art"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Mini Album Kapagi -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dual_music_art_card"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#22252A"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/dual_music_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_album_art"
                android:padding="16dp"
                app:tint="#88FFFFFF" />
        </androidx.cardview.widget.CardView>

        <!-- Parca & Sanatci Bilgisi -->
        <LinearLayout
            android:id="@+id/dual_music_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@id/dual_music_art_card"
            app:layout_constraintBottom_toBottomOf="@id/dual_music_art_card"
            app:layout_constraintStart_toEndOf="@id/dual_music_art_card"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/dual_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parça Adı"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/dual_music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sanatçı"
                android:textColor="#B3FFFFFF"
                android:textSize="17sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Canli Muzik Gorsellestirici Dalgalari -->
        <app.vela.carlauncher.widgets.MusicVisualizerView
            android:id="@+id/dual_music_visualizer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/dual_music_art_card"
            app:layout_constraintBottom_toTopOf="@id/dual_music_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Ilerleme Cubugu -->
        <ProgressBar
            android:id="@+id/dual_music_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginBottom="14dp"
            android:max="1000"
            android:progressTint="#3FD9CA"
            android:progressBackgroundTint="#26FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dual_music_controls_pill"/>

        <!-- Modern Kapsul Kontroller (Onceki, Oynat/Duraklat, Sonraki) -->
        <LinearLayout
            android:id="@+id/dual_music_controls_pill"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#26FFFFFF"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/dual_music_btn_prev"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_music_prev"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#DDFFFFFF" />

            <ImageButton
                android:id="@+id/dual_music_btn_play"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="22dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/cl_primary"
                android:src="@android:drawable/ic_media_play"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/dual_music_btn_next"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_music_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#DDFFFFFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
