<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="20dp" android:bottom="20dp">
        <shape><corners android:radius="2dp"/><solid android:color="#34414F"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item android:id="@+id/seekbar_glow_progress" android:top="19dp" android:bottom="19dp">
                    <shape><corners android:radius="3dp"/><solid android:color="#4400E5FF"/></shape>
                </item>
                <item android:id="@+id/seekbar_main_progress" android:top="20dp" android:bottom="20dp">
                    <shape><corners android:radius="2dp"/><solid android:color="#00E5FF"/></shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
