<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hap (pill) form, acik/gunduz temasi: beyaza yakin yuzey -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cl_surface_light" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <!-- Ince kenar cizgisi -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/cl_border_light" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
